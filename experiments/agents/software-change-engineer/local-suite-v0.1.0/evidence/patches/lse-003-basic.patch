diff --git a/pricing.py b/pricing.py
index 02027b9..66b5343 100644
--- a/pricing.py
+++ b/pricing.py
@@ -2,10 +2,21 @@


 def final_price(price_cents, member=False, coupon_percent=0):
-    """Apply member or coupon discount; combined use is currently defective."""
+    """Return the integer-cent price after applicable member and coupon discounts."""
+    if isinstance(price_cents, bool) or not isinstance(price_cents, int):
+        raise TypeError("price_cents must be a non-negative integer")
+    if price_cents < 0:
+        raise ValueError("price_cents must be a non-negative integer")
+    if not isinstance(member, bool):
+        raise TypeError("member must be a boolean")
+    if isinstance(coupon_percent, bool) or not isinstance(coupon_percent, int):
+        raise TypeError("coupon_percent must be an integer from 0 through 100")
+    if not 0 <= coupon_percent <= 100:
+        raise ValueError("coupon_percent must be an integer from 0 through 100")
+
     result = price_cents
     if member:
         result -= result * 10 // 100
-    elif coupon_percent:
+    if coupon_percent:
         result -= result * coupon_percent // 100
     return result
diff --git a/tests/test_pricing.py b/tests/test_pricing.py
index e5cc0dc..00db5f6 100644
--- a/tests/test_pricing.py
+++ b/tests/test_pricing.py
@@ -13,6 +13,39 @@ class PricingTests(unittest.TestCase):
     def test_coupon_discount(self):
         self.assertEqual(final_price(1000, coupon_percent=20), 800)

+    def test_member_and_coupon_stack_with_floor_arithmetic(self):
+        self.assertEqual(final_price(999, member=True, coupon_percent=25), 675)
+
+    def test_discount_boundaries(self):
+        self.assertEqual(final_price(0, member=True, coupon_percent=100), 0)
+        self.assertEqual(final_price(19, member=True), 18)
+        self.assertEqual(final_price(1000, coupon_percent=0), 1000)
+        self.assertEqual(final_price(1000, coupon_percent=100), 0)
+
+    def test_invalid_types_raise_type_error(self):
+        for price_cents in (True, 1.0, "100"):
+            with self.subTest(price_cents=price_cents):
+                with self.assertRaises(TypeError):
+                    final_price(price_cents)
+
+        for member in (1, "yes", None):
+            with self.subTest(member=member):
+                with self.assertRaises(TypeError):
+                    final_price(100, member=member)
+
+        for coupon_percent in (True, 10.0, "10"):
+            with self.subTest(coupon_percent=coupon_percent):
+                with self.assertRaises(TypeError):
+                    final_price(100, coupon_percent=coupon_percent)
+
+    def test_invalid_ranges_raise_value_error(self):
+        with self.assertRaises(ValueError):
+            final_price(-1)
+        with self.assertRaises(ValueError):
+            final_price(100, coupon_percent=-1)
+        with self.assertRaises(ValueError):
+            final_price(100, coupon_percent=101)
+

 if __name__ == "__main__":
     unittest.main()
