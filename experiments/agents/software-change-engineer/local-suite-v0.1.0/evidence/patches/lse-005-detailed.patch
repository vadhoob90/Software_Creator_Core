diff --git a/summary.py b/summary.py
index 5902a22..4dac7e2 100644
--- a/summary.py
+++ b/summary.py
@@ -1,6 +1,22 @@
 """Build a small serialisable event summary."""


-def build_summary(events):
+def build_summary(events, max_items=None):
+    """Return a serialisable summary, optionally limiting listed messages."""
+    if max_items is not None:
+        if isinstance(max_items, bool) or not isinstance(max_items, int):
+            raise TypeError("max_items must be an integer or None")
+        if max_items < 0:
+            raise ValueError("max_items must be greater than or equal to zero")
+
     messages = [str(event) for event in events]
-    return {"count": len(messages), "messages": messages}
+    if max_items is None:
+        limited_messages = messages
+    else:
+        limited_messages = messages[:max_items]
+
+    return {
+        "count": len(messages),
+        "messages": limited_messages,
+        "truncated": len(limited_messages) < len(messages),
+    }
diff --git a/tests/test_summary.py b/tests/test_summary.py
index d22b09f..1dbe087 100644
--- a/tests/test_summary.py
+++ b/tests/test_summary.py
@@ -8,6 +8,46 @@ class SummaryTests(unittest.TestCase):
         result = build_summary(["a", "b"])
         self.assertEqual(result["count"], 2)
         self.assertEqual(result["messages"], ["a", "b"])
+        self.assertFalse(result["truncated"])
+
+    def test_none_max_items_preserves_all_messages(self):
+        result = build_summary(["a", "b"], None)
+        self.assertEqual(result["count"], 2)
+        self.assertEqual(result["messages"], ["a", "b"])
+        self.assertFalse(result["truncated"])
+
+    def test_max_items_limits_messages_but_preserves_count(self):
+        result = build_summary(["a", "b", "c"], 2)
+        self.assertEqual(result["count"], 3)
+        self.assertEqual(result["messages"], ["a", "b"])
+        self.assertTrue(result["truncated"])
+
+    def test_zero_max_items_omits_all_messages(self):
+        result = build_summary(["a"], 0)
+        self.assertEqual(result["count"], 1)
+        self.assertEqual(result["messages"], [])
+        self.assertTrue(result["truncated"])
+
+    def test_zero_max_items_does_not_truncate_empty_input(self):
+        result = build_summary([], 0)
+        self.assertEqual(result["count"], 0)
+        self.assertEqual(result["messages"], [])
+        self.assertFalse(result["truncated"])
+
+    def test_max_items_at_or_above_count_does_not_truncate(self):
+        result = build_summary(["a", "b"], 3)
+        self.assertEqual(result["messages"], ["a", "b"])
+        self.assertFalse(result["truncated"])
+
+    def test_non_integer_max_items_raises_type_error(self):
+        for max_items in (True, False, 1.0, "1"):
+            with self.subTest(max_items=max_items):
+                with self.assertRaises(TypeError):
+                    build_summary([], max_items)
+
+    def test_negative_max_items_raises_value_error(self):
+        with self.assertRaises(ValueError):
+            build_summary([], -1)


