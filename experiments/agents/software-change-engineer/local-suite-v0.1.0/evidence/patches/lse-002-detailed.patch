diff --git a/priority.py b/priority.py
index c9677c7..a5cfed9 100644
--- a/priority.py
+++ b/priority.py
@@ -2,8 +2,27 @@


 def parse_priority(record):
-    """Return a priority, currently defaulting malformed data silently."""
-    try:
-        return int(record.get("priority", 0))
-    except (TypeError, ValueError):
+    """Return a supplied priority, or zero when it is absent.
+
+    Priorities are limited to integer values from zero through five.  Invalid
+    supplied values are rejected so they cannot be mistaken for missing data.
+    """
+    if "priority" not in record:
         return 0
+
+    value = record["priority"]
+    if isinstance(value, bool):
+        raise ValueError("priority must be an integer from 0 through 5")
+
+    try:
+        priority = int(value, 10) if isinstance(value, str) else int(value)
+    except (TypeError, ValueError) as error:
+        raise ValueError("priority must be an integer from 0 through 5") from error
+
+    if not isinstance(value, (int, str)):
+        raise ValueError("priority must be an integer from 0 through 5")
+
+    if not 0 <= priority <= 5:
+        raise ValueError("priority must be an integer from 0 through 5")
+
+    return priority
diff --git a/tests/test_priority.py b/tests/test_priority.py
index 8cd8749..aefca5c 100644
--- a/tests/test_priority.py
+++ b/tests/test_priority.py
@@ -7,8 +7,25 @@ class PriorityTests(unittest.TestCase):
     def test_missing_defaults_to_zero(self):
         self.assertEqual(parse_priority({}), 0)

-    def test_integer_string_is_accepted(self):
-        self.assertEqual(parse_priority({"priority": "3"}), 3)
+    def test_integers_and_decimal_integer_strings_within_range_are_accepted(self):
+        for priority in range(6):
+            for value in (priority, str(priority)):
+                with self.subTest(value=value):
+                    self.assertEqual(parse_priority({"priority": value}), priority)
+
+    def test_invalid_values_are_rejected(self):
+        for value in (True, False, "", " ", "1.5", 1.5, None, -1, 6, "-1", "6"):
+            with self.subTest(value=value):
+                with self.assertRaises(ValueError):
+                    parse_priority({"priority": value})
+
+    def test_conversion_failure_preserves_cause(self):
+        for value, cause_type in (("not-a-priority", ValueError), (None, TypeError)):
+            with self.subTest(value=value):
+                with self.assertRaises(ValueError) as raised:
+                    parse_priority({"priority": value})
+
+                self.assertIsInstance(raised.exception.__cause__, cause_type)


