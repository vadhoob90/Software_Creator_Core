diff --git a/retry_policy.py b/retry_policy.py
index 65b19c4..8a22bdf 100644
--- a/retry_policy.py
+++ b/retry_policy.py
@@ -8,8 +8,14 @@ def _non_negative_integer(name, value):
         raise ValueError(f"{name} must be non-negative")


-def retry_delays(attempts, base_seconds=1):
-    """Return exponential delays for the requested number of attempts."""
+def retry_delays(attempts, base_seconds=1, max_delay_seconds=None):
+    """Return exponential delays, optionally capped at a maximum value."""
     _non_negative_integer("attempts", attempts)
     _non_negative_integer("base_seconds", base_seconds)
-    return [base_seconds * (2**index) for index in range(attempts)]
+    if max_delay_seconds is not None:
+        _non_negative_integer("max_delay_seconds", max_delay_seconds)
+
+    delays = [base_seconds * (2**index) for index in range(attempts)]
+    if max_delay_seconds is not None:
+        return [min(delay, max_delay_seconds) for delay in delays]
+    return delays
diff --git a/tests/test_retry_policy.py b/tests/test_retry_policy.py
index 9a3fd3e..af90b56 100644
--- a/tests/test_retry_policy.py
+++ b/tests/test_retry_policy.py
@@ -10,6 +10,25 @@ class RetryDelayTests(unittest.TestCase):
     def test_zero_attempts(self):
         self.assertEqual(retry_delays(0), [])

+    def test_none_maximum_preserves_default_schedule(self):
+        self.assertEqual(retry_delays(4, 2, None), [2, 4, 8, 16])
+
+    def test_maximum_caps_every_delay(self):
+        self.assertEqual(retry_delays(4, 2, 5), [2, 4, 5, 5])
+
+    def test_zero_maximum_caps_every_delay(self):
+        self.assertEqual(retry_delays(4, 2, 0), [0, 0, 0, 0])
+
+    def test_non_integer_maximum_is_rejected(self):
+        for value in (True, 1.5, "5"):
+            with self.subTest(value=value):
+                with self.assertRaises(TypeError):
+                    retry_delays(1, max_delay_seconds=value)
+
+    def test_negative_maximum_is_rejected(self):
+        with self.assertRaises(ValueError):
+            retry_delays(1, max_delay_seconds=-1)
+

 if __name__ == "__main__":
     unittest.main()
