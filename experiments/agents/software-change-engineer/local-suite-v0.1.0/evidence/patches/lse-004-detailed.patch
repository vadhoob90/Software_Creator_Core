diff --git a/profile_store.py b/profile_store.py
index a8362cd..edf8bfc 100644
--- a/profile_store.py
+++ b/profile_store.py
@@ -22,3 +22,21 @@ class ProfileStore:
             return self._profiles[profile_id].copy()
         except KeyError:
             raise KeyError(f"unknown profile: {profile_id}") from None
+
+    def update_profile(self, profile_id, **changes):
+        """Update a profile's mutable fields and return an independent copy."""
+        allowed_fields = {"name", "email"}
+        if not changes or set(changes) - allowed_fields:
+            raise ValueError("updates must include only name and/or email")
+        if any(not isinstance(value, str) or value == "" for value in changes.values()):
+            raise ValueError("updated values must be non-empty strings")
+
+        try:
+            profile = self._profiles[profile_id]
+        except KeyError:
+            raise KeyError(f"unknown profile: {profile_id}") from None
+
+        updated_profile = profile.copy()
+        updated_profile.update(changes)
+        self._profiles[profile_id] = updated_profile
+        return updated_profile.copy()
diff --git a/tests/test_profile_store.py b/tests/test_profile_store.py
index 8be06cd..37cf88a 100644
--- a/tests/test_profile_store.py
+++ b/tests/test_profile_store.py
@@ -10,6 +10,59 @@ class ProfileStoreTests(unittest.TestCase):
         created["name"] = "mutated"
         self.assertEqual(store.get_profile("p-1")["name"], "Ada")

+    def test_update_profile_updates_each_mutable_field_independently(self):
+        store = ProfileStore()
+        store.create_profile("p-1", "Ada", "ada@example.test", "2026-01-02T03:04:05Z")
+
+        name_updated = store.update_profile("p-1", name="Grace")
+        email_updated = store.update_profile("p-1", email="grace@example.test")
+
+        self.assertEqual(name_updated["name"], "Grace")
+        self.assertEqual(name_updated["email"], "ada@example.test")
+        self.assertEqual(email_updated["name"], "Grace")
+        self.assertEqual(email_updated["email"], "grace@example.test")
+
+    def test_update_profile_preserves_identity_and_returns_a_copy(self):
+        store = ProfileStore()
+        store.create_profile("p-1", "Ada", "ada@example.test", "2026-01-02T03:04:05Z")
+
+        updated = store.update_profile("p-1", name="Grace")
+        updated["name"] = "mutated"
+        stored = store.get_profile("p-1")
+
+        self.assertEqual(stored["profile_id"], "p-1")
+        self.assertEqual(stored["created_at"], "2026-01-02T03:04:05Z")
+        self.assertEqual(stored["name"], "Grace")
+
+    def test_update_profile_rejects_unknown_profile(self):
+        with self.assertRaisesRegex(KeyError, "unknown profile: missing"):
+            ProfileStore().update_profile("missing", name="Ada")
+
+    def test_update_profile_rejects_invalid_changes_without_mutating_profile(self):
+        store = ProfileStore()
+        store.create_profile("p-1", "Ada", "ada@example.test", "2026-01-02T03:04:05Z")
+        invalid_changes = (
+            {},
+            {"nickname": "Ada"},
+            {"name": ""},
+            {"email": 42},
+            {"name": "Grace", "email": ""},
+        )
+
+        for changes in invalid_changes:
+            with self.subTest(changes=changes):
+                with self.assertRaises(ValueError):
+                    store.update_profile("p-1", **changes)
+                self.assertEqual(
+                    store.get_profile("p-1"),
+                    {
+                        "profile_id": "p-1",
+                        "name": "Ada",
+                        "email": "ada@example.test",
+                        "created_at": "2026-01-02T03:04:05Z",
+                    },
+                )
+

 if __name__ == "__main__":
     unittest.main()
