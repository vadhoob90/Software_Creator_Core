{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vadhoob90/PDLC_Core/experiments/agents/software-change-engineer/local-suite-v0.2.0/schemas/aggregate-result.schema.json",
  "title": "Software Change Engineer aggregate evaluation result 0.2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite",
    "status",
    "randomisation_seed",
    "runs",
    "hard_gate_summary",
    "eligible_pairs",
    "dimension_summary"
  ],
  "properties": {
    "schema_version": {"const": "0.2.0"},
    "suite": {"const": "pdlc-core.sce-local-suite@0.2.0"},
    "status": {"enum": ["running", "completed"]},
    "randomisation_seed": {"type": "string", "minLength": 1},
    "runs": {
      "type": "array",
      "items": {"$ref": "#/$defs/runSummary"}
    },
    "hard_gate_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basic_passes", "detailed_passes"],
      "properties": {
        "basic_passes": {"type": "integer", "minimum": 0, "maximum": 20},
        "detailed_passes": {"type": "integer", "minimum": 0, "maximum": 20}
      }
    },
    "eligible_pairs": {"type": "integer", "minimum": 0, "maximum": 20},
    "dimension_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comprehension_scope",
        "test_effectiveness",
        "failure_evidence_integrity",
        "lifecycle_compatibility",
        "handoff_usability"
      ],
      "properties": {
        "comprehension_scope": {"$ref": "#/$defs/dimensionSummary"},
        "test_effectiveness": {"$ref": "#/$defs/dimensionSummary"},
        "failure_evidence_integrity": {"$ref": "#/$defs/dimensionSummary"},
        "lifecycle_compatibility": {"$ref": "#/$defs/dimensionSummary"},
        "handoff_usability": {"$ref": "#/$defs/dimensionSummary"}
      }
    },
    "decision": {"enum": ["retain", "shorten", "reshape", "reject", "inconclusive"]},
    "decision_rationale": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "completed"}}},
      "then": {
        "required": ["decision", "decision_rationale"],
        "properties": {"runs": {"minItems": 40, "maxItems": 40}}
      }
    }
  ],
  "$defs": {
    "qualityScores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comprehension_scope",
        "test_effectiveness",
        "failure_evidence_integrity",
        "lifecycle_compatibility",
        "handoff_usability"
      ],
      "properties": {
        "comprehension_scope": {"type": "integer", "minimum": 0, "maximum": 2},
        "test_effectiveness": {"type": "integer", "minimum": 0, "maximum": 2},
        "failure_evidence_integrity": {"type": "integer", "minimum": 0, "maximum": 2},
        "lifecycle_compatibility": {"type": "integer", "minimum": 0, "maximum": 2},
        "handoff_usability": {"type": "integer", "minimum": 0, "maximum": 2}
      }
    },
    "runSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "task",
        "condition",
        "run_record",
        "seed_commit",
        "runtime_fingerprint",
        "hard_gate_pass",
        "quality_scores"
      ],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "task": {"type": "string", "pattern": "^LSE-1(?:0[1-9]|1[0-9]|20)$"},
        "condition": {"enum": ["basic", "detailed"]},
        "run_record": {"type": "string", "minLength": 1},
        "seed_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "runtime_fingerprint": {"type": "string", "minLength": 1},
        "hard_gate_pass": {"type": "boolean"},
        "quality_scores": {
          "oneOf": [
            {"$ref": "#/$defs/qualityScores"},
            {"type": "null"}
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"hard_gate_pass": {"const": true}}},
          "then": {"properties": {"quality_scores": {"$ref": "#/$defs/qualityScores"}}},
          "else": {"properties": {"quality_scores": {"type": "null"}}}
        }
      ]
    },
    "dimensionSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basic_score_sum", "detailed_score_sum", "detailed_wins", "ties", "basic_wins"],
      "properties": {
        "basic_score_sum": {"type": "integer", "minimum": 0, "maximum": 40},
        "detailed_score_sum": {"type": "integer", "minimum": 0, "maximum": 40},
        "detailed_wins": {"type": "integer", "minimum": 0, "maximum": 20},
        "ties": {"type": "integer", "minimum": 0, "maximum": 20},
        "basic_wins": {"type": "integer", "minimum": 0, "maximum": 20}
      }
    }
  }
}
