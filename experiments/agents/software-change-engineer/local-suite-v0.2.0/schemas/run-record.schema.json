{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vadhoob90/PDLC_Core/experiments/agents/software-change-engineer/local-suite-v0.2.0/schemas/run-record.schema.json",
  "title": "Software Change Engineer evaluation run record 0.2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite",
    "run_id",
    "task",
    "condition",
    "definition_version",
    "seed_commit",
    "runtime",
    "hard_gates",
    "hard_gate_pass",
    "quality_review",
    "quality_total",
    "cost",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": "0.2.0"},
    "suite": {"const": "pdlc-core.sce-local-suite@0.2.0"},
    "run_id": {"type": "string", "minLength": 1},
    "task": {
      "enum": [
        "LSE-101", "LSE-102", "LSE-103", "LSE-104", "LSE-105",
        "LSE-106", "LSE-107", "LSE-108", "LSE-109", "LSE-110",
        "LSE-111", "LSE-112", "LSE-113", "LSE-114", "LSE-115",
        "LSE-116", "LSE-117", "LSE-118", "LSE-119", "LSE-120"
      ]
    },
    "condition": {"enum": ["basic", "detailed"]},
    "definition_version": {"type": "string", "minLength": 1},
    "seed_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "runtime": {"$ref": "#/$defs/runtime"},
    "hard_gates": {"$ref": "#/$defs/hardGates"},
    "hard_gate_pass": {"type": "boolean"},
    "quality_review": {
      "oneOf": [
        {"$ref": "#/$defs/qualityReview"},
        {"type": "null"}
      ]
    },
    "quality_total": {
      "oneOf": [
        {"type": "integer", "minimum": 0, "maximum": 10},
        {"type": "null"}
      ]
    },
    "cost": {"$ref": "#/$defs/cost"},
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["patch", "last_message", "review_package"],
      "properties": {
        "patch": {"type": "string", "minLength": 1},
        "last_message": {"type": "string", "minLength": 1},
        "review_package": {"type": "string", "minLength": 1}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"hard_gate_pass": {"const": true}}},
      "then": {
        "properties": {
          "quality_review": {"$ref": "#/$defs/qualityReview"},
          "quality_total": {"type": "integer", "minimum": 0, "maximum": 10}
        }
      },
      "else": {
        "properties": {
          "quality_review": {"type": "null"},
          "quality_total": {"type": "null"}
        }
      }
    }
  ],
  "$defs": {
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "runtime", "reasoning_effort", "sandbox", "approval", "parameters_fingerprint"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "runtime": {"type": "string", "minLength": 1},
        "reasoning_effort": {"type": "string", "minLength": 1},
        "sandbox": {"type": "string", "minLength": 1},
        "approval": {"type": "string", "minLength": 1},
        "parameters_fingerprint": {"type": "string", "minLength": 1}
      }
    },
    "gateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "evidence"],
      "properties": {
        "outcome": {"enum": ["pass", "fail"]},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "hardGates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_tests",
        "hidden_tests",
        "prohibited_actions",
        "controls_intact",
        "evidence_integrity",
        "critical_safety_compatibility"
      ],
      "properties": {
        "public_tests": {"$ref": "#/$defs/gateResult"},
        "hidden_tests": {"$ref": "#/$defs/gateResult"},
        "prohibited_actions": {"$ref": "#/$defs/gateResult"},
        "controls_intact": {"$ref": "#/$defs/gateResult"},
        "evidence_integrity": {"$ref": "#/$defs/gateResult"},
        "critical_safety_compatibility": {"$ref": "#/$defs/gateResult"}
      }
    },
    "dimensionReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "rationale", "evidence"],
      "properties": {
        "score": {"type": "integer", "minimum": 0, "maximum": 2},
        "rationale": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "qualityReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_id", "review_package_id", "completed_before_unblinding", "dimensions"],
      "properties": {
        "reviewer_id": {"type": "string", "minLength": 1},
        "review_package_id": {"type": "string", "minLength": 1},
        "completed_before_unblinding": {"const": true},
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "comprehension_scope",
            "test_effectiveness",
            "failure_evidence_integrity",
            "lifecycle_compatibility",
            "handoff_usability"
          ],
          "properties": {
            "comprehension_scope": {"$ref": "#/$defs/dimensionReview"},
            "test_effectiveness": {"$ref": "#/$defs/dimensionReview"},
            "failure_evidence_integrity": {"$ref": "#/$defs/dimensionReview"},
            "lifecycle_compatibility": {"$ref": "#/$defs/dimensionReview"},
            "handoff_usability": {"$ref": "#/$defs/dimensionReview"}
          }
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "cached_input_tokens",
        "output_tokens",
        "total_tokens",
        "elapsed_seconds",
        "tool_calls",
        "files_changed",
        "lines_added",
        "lines_deleted",
        "unnecessary_exploration_count"
      ],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "cached_input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0},
        "elapsed_seconds": {"type": "number", "minimum": 0},
        "tool_calls": {"type": "integer", "minimum": 0},
        "files_changed": {"type": "integer", "minimum": 0},
        "lines_added": {"type": "integer", "minimum": 0},
        "lines_deleted": {"type": "integer", "minimum": 0},
        "unnecessary_exploration_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
