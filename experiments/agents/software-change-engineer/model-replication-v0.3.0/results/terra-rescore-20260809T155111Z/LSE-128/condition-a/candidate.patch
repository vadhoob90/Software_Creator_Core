+
+    def pop(self, key: StashKey[T], default: D | object = ...) -> T | D:
+        """Get and remove the value for key.
+
+        If key was not set before, return default if given. Otherwise, raise
+        ``KeyError``.
+        """
+        try:
+            return cast(T, self._storage.pop(key))
+        except KeyError:
+            if default is ...:
+                raise
+            return cast(D, default)
