diff --git a/src/requests/structures.py b/src/requests/structures.py
index 7675eaf..ce61377 100644
--- a/src/requests/structures.py
+++ b/src/requests/structures.py
@@ -57,10 +57,29 @@ class CaseInsensitiveDict(MutableMapping[str, _VT], Generic[_VT]):
         self.update(data, **kwargs)
 
     def __setitem__(self, key: str, value: _VT) -> None:
+        if not isinstance(key, str):
+            raise TypeError(f"Header keys must be strings, not {type(key).__name__}.")
         # Use the lowercased key for lookups, but store the actual
         # key alongside the value.
         self._store[key.lower()] = (key, value)
 
+    def update(
+        self,
+        data: Mapping[str, _VT] | Iterable[tuple[str, _VT]] = (),
+        **kwargs: _VT,
+    ) -> None:
+        items = list(data.items()) if isinstance(data, Mapping) else list(data)
+        items.extend(kwargs.items())
+
+        for key, _ in items:
+            if not isinstance(key, str):
+                raise TypeError(
+                    f"Header keys must be strings, not {type(key).__name__}."
+                )
+
+        for key, value in items:
+            self[key] = value
+
     def __getitem__(self, key: str) -> _VT:
         return self._store[key.lower()][1]
 
