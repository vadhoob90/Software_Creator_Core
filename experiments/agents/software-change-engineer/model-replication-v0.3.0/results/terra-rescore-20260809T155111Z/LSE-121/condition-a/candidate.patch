diff --git a/tests/test_hooks.py b/tests/test_hooks.py
index 7445525..2633fb1 100644
--- a/tests/test_hooks.py
+++ b/tests/test_hooks.py
@@ -20,3 +20,33 @@ def test_hooks(hooks_list, result):
 
 def test_default_hooks():
     assert hooks.default_hooks() == {"response": []}
+
+
+@pytest.mark.parametrize(
+    "hook_list",
+    (
+        [hook, hook],
+        (hook, hook),
+        (item for item in (hook, hook)),
+    ),
+)
+def test_dispatch_hook_accepts_iterable_hooks(hook_list):
+    assert hooks.dispatch_hook("response", {"response": hook_list}, "Data") == "ta"
+
+
+def test_dispatch_hook_validates_all_hooks_before_dispatch():
+    calls = []
+
+    def side_effect_hook(value):
+        calls.append(value)
+        return value
+
+    with pytest.raises(
+        TypeError,
+        match=r"Hook for event 'response' at position 1 is not callable\.",
+    ):
+        hooks.dispatch_hook(
+            "response", {"response": [side_effect_hook, object()]}, "Data"
+        )
+
+    assert calls == []
