+@pytest.mark.parametrize("header", ["API-Key", b"X-API-Key"])
+def test_sensitive_headers_are_case_insensitive_and_preserve_values(header):
+    values = ["example-value-one", "example-value-two"]
+    headers = httpx.Headers([(header, value) for value in values])
+    header_name = header.decode() if isinstance(header, bytes) else header
+
+    assert repr(headers) == (
+        f"Headers([({header_name!r}, "
+        "'[secure]'), "
+        f"({header_name!r}, '[secure]')])"
+    )
+    assert headers[header_name] == ", ".join(values)
+    assert headers.raw == [
+        (
+            header if isinstance(header, bytes) else header.encode(),
+            value.encode(),
+        )
+        for value in values
+    ]
+    assert list(headers.items()) == [
+        (header_name, ", ".join(values))
+    ]
+    assert headers.multi_items() == [
+        (header_name, value) for value in values
+    ]
+
