@@ -0,0 +1,43 @@
+from __future__ import annotations
+
+import math
+
+from _pytest import timing
+import pytest
+
+
+@pytest.mark.parametrize("seconds", [0, 1, 1.5])
+def test_mock_timing_sleep_advances_by_finite_non_negative_duration(seconds: float) -> None:
+    mock_timing = timing.MockTiming()
+    start = mock_timing.time()
+
+    mock_timing.sleep(seconds)
+
+    assert mock_timing.time() == start + seconds
+
+
+@pytest.mark.parametrize("seconds", [-1, math.nan, math.inf, -math.inf])
+def test_mock_timing_sleep_rejects_invalid_duration_without_advancing(
+    seconds: float,
+) -> None:
+    mock_timing = timing.MockTiming()
+    start = mock_timing.time()
+
+    with pytest.raises(ValueError, match="finite, non-negative"):
+        mock_timing.sleep(seconds)
+
+    assert mock_timing.time() == start
+
+
+@pytest.mark.parametrize("seconds", [-1, math.nan, math.inf, -math.inf])
+def test_rejected_mock_timing_sleep_cannot_make_elapsed_negative(
+    monkeypatch: pytest.MonkeyPatch, seconds: float
+) -> None:
+    mock_timing = timing.MockTiming()
+    mock_timing.patch(monkeypatch)
+    instant = timing.Instant()
+
+    with pytest.raises(ValueError, match="finite, non-negative"):
+        timing.sleep(seconds)
+
+    assert instant.elapsed().seconds == 0
