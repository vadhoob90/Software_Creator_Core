+    )
+    def test_invalid_update_is_atomic(self, items):
+        original = self.case_insensitive_dict.copy()
+
+        with pytest.raises(
+            TypeError, match="header keys must be strings, received int"
+        ):
+            self.case_insensitive_dict.update(items)
+
+        assert self.case_insensitive_dict == original
+
+    def test_valid_iterable_update_preserves_casing_behavior(self):
+        self.case_insensitive_dict.update(
+            [("ACCEPT", "text/plain"), ("User-Agent", "requests")]
+        )
+
+        assert dict(self.case_insensitive_dict) == {
+            "ACCEPT": "text/plain",
+            "User-Agent": "requests",
+        }
