         assert copy is not self.case_insensitive_dict
         assert copy == self.case_insensitive_dict
 
+    def test_setitem_rejects_non_string_key(self):
+        with pytest.raises(
+            TypeError, match="header keys must be strings, received int"
+        ):
+            self.case_insensitive_dict[1] = "invalid"  # type: ignore[index]
+
+    def test_mapping_update_rejects_non_string_key_atomically(self):
+        original = self.case_insensitive_dict.copy()
+
+        with pytest.raises(
+            TypeError, match="header keys must be strings, received int"
+        ):
+            self.case_insensitive_dict.update(  # type: ignore[arg-type]
+                {"Content-Type": "text/plain", 1: "x"}
+            )
+
+        assert self.case_insensitive_dict == original
+
+    def test_iterable_update_rejects_non_string_key_atomically(self):
+        original = self.case_insensitive_dict.copy()
+
+        with pytest.raises(
+            TypeError, match="header keys must be strings, received NoneType"
+        ):
+            self.case_insensitive_dict.update(  # type: ignore[arg-type]
+                [("Content-Type", "text/plain"), (None, "x")]
+            )
+
+        assert self.case_insensitive_dict == original
+
+    def test_valid_update_preserves_replacement_casing(self):
+        self.case_insensitive_dict.update(
+            [("Content-Type", "text/plain"), ("accept", "text/html")],
+            Authorization="Bearer token",
+        )
+
+        assert list(self.case_insensitive_dict.items()) == [
+            ("accept", "text/html"),
+            ("Content-Type", "text/plain"),
+            ("Authorization", "Bearer token"),
+        ]
+
