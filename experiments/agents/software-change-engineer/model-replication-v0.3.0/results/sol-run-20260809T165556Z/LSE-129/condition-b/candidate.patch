@@ -0,0 +1,35 @@
+from __future__ import annotations
+
+import math
+
+import pytest
+
+from _pytest import timing
+
+
+@pytest.mark.parametrize("seconds", [-1, math.nan, math.inf, -math.inf])
+def test_mock_timing_rejects_invalid_sleep_duration(
+    seconds: float, mock_timing: timing.MockTiming
+) -> None:
+    initial_time = mock_timing.time()
+    instant = timing.Instant()
+
+    with pytest.raises(
+        ValueError, match="sleep duration must be a non-negative finite number"
+    ):
+        mock_timing.sleep(seconds)
+
+    assert mock_timing.time() == initial_time
+    assert instant.elapsed().seconds >= 0
+
+
+@pytest.mark.parametrize("seconds", [0, 1, 0.5])
+def test_mock_timing_accepts_non_negative_finite_sleep_duration(
+    seconds: float,
+) -> None:
+    mock_timing = timing.MockTiming()
+    initial_time = mock_timing.time()
+
+    mock_timing.sleep(seconds)
+
+    assert mock_timing.time() == initial_time + seconds
