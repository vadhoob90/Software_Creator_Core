diff --git a/testing/test_pytester.py b/testing/test_pytester.py
index f641e9e..3354884 100644
--- a/testing/test_pytester.py
+++ b/testing/test_pytester.py
@@ -19,6 +19,34 @@ import _pytest.timing
 import pytest
 
 
+@pytest.mark.parametrize("seconds", [-1, -0.5, float("nan"), float("inf"), float("-inf")])
+def test_mock_timing_rejects_invalid_sleep(
+    seconds: float, monkeypatch: MonkeyPatch
+) -> None:
+    mock_timing = _pytest.timing.MockTiming()
+    mock_timing.patch(monkeypatch)
+    before = mock_timing.time()
+    instant = _pytest.timing.Instant()
+
+    with pytest.raises(
+        ValueError, match="sleep duration must be a non-negative finite number"
+    ):
+        mock_timing.sleep(seconds)
+
+    assert mock_timing.time() == before
+    assert instant.elapsed().seconds >= 0
+
+
+@pytest.mark.parametrize("seconds", [0, 1, 0.5])
+def test_mock_timing_accepts_non_negative_finite_sleep(seconds: float) -> None:
+    mock_timing = _pytest.timing.MockTiming()
+    before = mock_timing.time()
+
+    mock_timing.sleep(seconds)
+
+    assert mock_timing.time() == before + seconds
+
