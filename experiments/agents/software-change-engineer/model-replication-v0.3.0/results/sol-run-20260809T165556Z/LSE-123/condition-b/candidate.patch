+def test_progress_bar_finish_applies_pending_update_once(runner):
+    bar = _create_progress(update_min_steps=5)
+    bar.update(3)
+
+    bar.finish()
+
+    assert bar._completed_intervals == 0
+    assert bar.pos == 3
+    assert bar.finished
+
+    bar.finish()
+
+    assert bar.pos == 3
