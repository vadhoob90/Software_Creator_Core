diff --git a/tests/test_termui.py b/tests/test_termui.py
index 98e2577..5e108c5 100644
--- a/tests/test_termui.py
+++ b/tests/test_termui.py
@@ -350,6 +350,27 @@ def test_progress_bar_update_min_steps(runner):
     assert bar.pos == 5
 
 
+@pytest.mark.parametrize("update_min_steps", (0, -1))
+def test_progress_bar_update_min_steps_must_be_positive(update_min_steps):
+    with pytest.raises(ValueError, match="update_min_steps must be at least 1"):
+        click.progressbar(length=10, update_min_steps=update_min_steps)
+
+
+def test_progress_bar_finish_applies_pending_update_once():
+    bar = click.progressbar(length=10, update_min_steps=5)
+    bar.update(3)
+
+    bar.finish()
+
+    assert bar.pos == 3
+    assert bar._completed_intervals == 0
+    assert bar.finished
+
+    bar.finish()
+
+    assert bar.pos == 3
+
+
