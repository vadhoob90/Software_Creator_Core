+@pytest.mark.parametrize("header", ["API-Key", b"X-API-KEY"])
+def test_sensitive_headers_are_case_insensitive_for_str_and_bytes(header):
+    headers = httpx.Headers([(header, b"placeholder")])
+    expected_header = (
+        header.decode().lower() if isinstance(header, bytes) else header.lower()
+    )
+
+    assert repr(headers) == "Headers({'%s': '[secure]'})" % expected_header
+
+
+def test_repeated_sensitive_headers_are_redacted_without_mutating_values():
+    headers = httpx.Headers(
+        [("X-API-Key", "placeholder-one"), ("x-api-key", "placeholder-two")]
+    )
+
+    assert repr(headers) == (
+        "Headers([('x-api-key', '[secure]'), ('x-api-key', '[secure]')])"
+    )
+    assert headers["x-api-key"] == "placeholder-one, placeholder-two"
+    assert headers.raw == [
+        (b"X-API-Key", b"placeholder-one"),
+        (b"x-api-key", b"placeholder-two"),
+    ]
+    assert list(headers.items()) == [("x-api-key", "placeholder-one, placeholder-two")]
+    assert headers.multi_items() == [
+        ("x-api-key", "placeholder-one"),
+        ("x-api-key", "placeholder-two"),
+    ]
+
