diff --git a/tests/test_measure.py b/tests/test_measure.py
index 6155922..c3e3b85 100644
--- a/tests/test_measure.py
+++ b/tests/test_measure.py
@@ -34,3 +34,37 @@ def test_clamp():
     assert measurement.clamp(None, 50) == Measurement(20, 50)
     assert measurement.clamp(30, None) == Measurement(30, 100)
     assert measurement.clamp(None, None) == Measurement(20, 100)
+    assert measurement == Measurement(20, 100)
+
+
+@pytest.mark.parametrize(
+    ("method_name", "invalid_width", "bound_name"),
+    [
+        ("with_minimum", -1, "minimum"),
+        ("with_maximum", -2, "maximum"),
+    ],
+)
+def test_negative_bounds(method_name, invalid_width, bound_name):
+    measurement = Measurement(20, 100)
+
+    with pytest.raises(ValueError, match=rf"{bound_name}.*{invalid_width}"):
+        getattr(measurement, method_name)(invalid_width)
+
+    assert measurement == Measurement(20, 100)
+
+
+def test_clamp_rejects_inverted_bounds():
+    measurement = Measurement(20, 100)
+
+    with pytest.raises(ValueError, match=r"minimum width 60.*maximum width 50"):
+        measurement.clamp(60, 50)
+
+    assert measurement == Measurement(20, 100)
+
+
+def test_bound_operations_are_immutable():
+    measurement = Measurement(20, 100)
+
+    assert measurement.with_minimum(30) == Measurement(30, 100)
+    assert measurement.with_maximum(50) == Measurement(20, 50)
+    assert measurement == Measurement(20, 100)
