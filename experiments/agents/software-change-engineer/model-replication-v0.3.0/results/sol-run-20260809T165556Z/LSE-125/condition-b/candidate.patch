diff --git a/tests/test_measure.py b/tests/test_measure.py
index 6155922..d3a39f2 100644
--- a/tests/test_measure.py
+++ b/tests/test_measure.py
@@ -34,3 +34,26 @@ def test_clamp():
     assert measurement.clamp(None, 50) == Measurement(20, 50)
     assert measurement.clamp(30, None) == Measurement(30, 100)
     assert measurement.clamp(None, None) == Measurement(20, 100)
+    assert measurement == Measurement(20, 100)
+
+
+@pytest.mark.parametrize(
+    ("method_name", "bound_name"),
+    (("with_minimum", "minimum"), ("with_maximum", "maximum")),
+)
+def test_negative_bound(method_name, bound_name):
+    measurement = Measurement(20, 100)
+
+    with pytest.raises(ValueError, match=rf"{bound_name} width.*-1"):
+        getattr(measurement, method_name)(-1)
+
+    assert measurement == Measurement(20, 100)
+
+
+def test_clamp_rejects_inverted_bounds():
+    measurement = Measurement(20, 100)
+
+    with pytest.raises(ValueError, match=r"minimum width 51.*maximum width 50"):
+        measurement.clamp(51, 50)
+
+    assert measurement == Measurement(20, 100)
