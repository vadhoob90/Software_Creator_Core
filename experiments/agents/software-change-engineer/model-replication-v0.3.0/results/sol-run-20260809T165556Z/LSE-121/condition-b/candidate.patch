+@pytest.mark.parametrize("hooks_list", ([hook, None], (hook, None)))
+def test_invalid_hook_collection_is_rejected_before_dispatch(hooks_list):
+    calls = []
+
+    def recording_hook(value):
+        calls.append(value)
+
+    hooks_list = type(hooks_list)((recording_hook, *hooks_list[1:]))
+
+    with pytest.raises(
+        TypeError, match="Hook event 'response'.*non-callable entry at position 1"
+    ):
+        hooks.dispatch_hook("response", {"response": hooks_list}, "Data")
+
+    assert calls == []
+
+
+def test_invalid_generator_hook_is_rejected_before_dispatch():
+    calls = []
+
+    def recording_hook(value):
+        calls.append(value)
+
+    hook_generator = (item for item in (recording_hook, None))
+
+    with pytest.raises(
+        TypeError, match="Hook event 'response'.*non-callable entry at position 1"
+    ):
+        hooks.dispatch_hook("response", {"response": hook_generator}, "Data")
+
+    assert calls == []
+
+
+def test_hook_exception_is_not_replaced():
+    exception = RuntimeError("hook failed")
+
+    def failing_hook(value):
+        raise exception
+
+    with pytest.raises(RuntimeError) as caught:
+        hooks.dispatch_hook("response", {"response": [failing_hook]}, "Data")
+
+    assert caught.value is exception
+
+
 def test_default_hooks():
     assert hooks.default_hooks() == {"response": []}
