diff --git a/tests/test_hooks.py b/tests/test_hooks.py
index 7445525..368ca17 100644
--- a/tests/test_hooks.py
+++ b/tests/test_hooks.py
@@ -20,3 +20,57 @@ def test_hooks(hooks_list, result):
 
 def test_default_hooks():
     assert hooks.default_hooks() == {"response": []}
+
+
+@pytest.mark.parametrize(
+    "hooks_list",
+    (
+        (hook, hook),
+        [hook, hook],
+        (item for item in (hook, hook)),
+    ),
+)
+def test_hook_iterables_are_supported(hooks_list):
+    assert hooks.dispatch_hook("response", {"response": hooks_list}, "Data") == "ta"
+
+
+def test_hook_collection_is_validated_before_dispatch():
+    calls = []
+
+    def recording_hook(value):
+        calls.append(value)
+
+    with pytest.raises(TypeError, match=r"response.*position 1"):
+        hooks.dispatch_hook(
+            "response", {"response": (recording_hook, object())}, "Data"
+        )
+
+    assert calls == []
+
+
+def test_hook_order_and_none_return_are_preserved():
+    calls = []
+
+    def first(value):
+        calls.append(("first", value))
+
+    def second(value):
+        calls.append(("second", value))
+        return value.lower()
+
+    assert (
+        hooks.dispatch_hook("response", {"response": (first, second)}, "Data") == "data"
+    )
+    assert calls == [("first", "Data"), ("second", "Data")]
+
+
+def test_hook_exception_is_not_replaced():
+    error = RuntimeError("hook failed")
+
+    def failing_hook(value):
+        raise error
+
+    with pytest.raises(RuntimeError) as exc_info:
+        hooks.dispatch_hook("response", {"response": failing_hook}, "Data")
+
+    assert exc_info.value is error
