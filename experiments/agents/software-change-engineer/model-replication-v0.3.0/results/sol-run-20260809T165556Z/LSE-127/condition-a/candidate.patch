+def test_queryparam_remove_value():
+    q = httpx.QueryParams("a=123&a=456&b=789&a=123")
+    result = q.remove_value("a", "123")
+
+    assert result.multi_items() == [
+        ("a", "456"),
+        ("a", "123"),
+        ("b", "789"),
+    ]
+    assert q.multi_items() == [
+        ("a", "123"),
+        ("a", "456"),
+        ("a", "123"),
+        ("b", "789"),
+    ]
+
+
+@pytest.mark.parametrize(
+    ("key", "value", "expected"),
+    [
+        (1, True, "1=false&1=true&2=true"),
+        (1, None, "1=false&1=true&2=true"),
+        ("missing", True, "1=false&1=true&1=&2=true"),
+    ],
+)
+def test_queryparam_remove_value_coercion_and_missing(key, value, expected):
+    q = httpx.QueryParams([(1, False), (1, True), (1, None), (2, True)])
+    result = q.remove_value(key, value)
+
+    assert str(result) == expected
+    assert result is not q
+    assert result._dict is not q._dict
+    assert all(
+        result_values is not q._dict[result_key]
+        for result_key, result_values in result._dict.items()
+    )
+
+
+def test_queryparam_remove_value_removes_last_value_for_key():
+    q = httpx.QueryParams("a=123&b=456")
+
+    assert str(q.remove_value("a", "123")) == "b=456"
+
+
