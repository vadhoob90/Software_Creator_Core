+    def remove_value(self, key: str, value: typing.Any = None) -> QueryParams:
+        """
+        Return a new QueryParams instance, removing the first matching value
+        of a key.
+
+        Usage:
+
+        q = httpx.QueryParams("a=123&a=456&a=123")
+        q = q.remove_value("a", "123")
+        assert q == httpx.QueryParams("a=456&a=123")
+        """
+        key = str(key)
+        value = primitive_value_to_str(value)
+        q = QueryParams(self)
+        values = q._dict.get(key)
+        if values is not None:
+            try:
+                values.remove(value)
+            except ValueError:
+                pass
+            if not values:
+                q._dict.pop(key)
+        return q
+
