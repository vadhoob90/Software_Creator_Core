+def test_queryparam_remove_value():
+    q = httpx.QueryParams("a=123&a=456&a=123&b=789")
+    removed = q.remove_value("a", "123")
+
+    assert removed.multi_items() == [("a", "456"), ("a", "123"), ("b", "789")]
+    assert q.multi_items() == [
+        ("a", "123"),
+        ("a", "456"),
+        ("a", "123"),
+        ("b", "789"),
+    ]
+
+
+def test_queryparam_remove_value_coerces_key_and_value():
+    q = httpx.QueryParams([(1, True), (1, None), (2, False)])
+
+    assert q.remove_value(1, True).multi_items() == [
+        ("1", ""),
+        ("2", "false"),
+    ]
+    assert q.remove_value(1, None).multi_items() == [
+        ("1", "true"),
+        ("2", "false"),
+    ]
+
+
+@pytest.mark.parametrize((("key", "value")), [("missing", "123"), ("a", "missing")])
+def test_queryparam_remove_value_missing_match_returns_independent_copy(key, value):
+    q = httpx.QueryParams("a=123&a=456&b=789")
+    unchanged = q.remove_value(key, value)
+
+    assert unchanged == q
+    assert unchanged is not q
+    assert unchanged._dict is not q._dict
+    assert all(unchanged._dict[item] is not q._dict[item] for item in q)
+
+
+def test_queryparam_remove_value_removes_last_value_with_key():
+    q = httpx.QueryParams("a=123&b=456")
+
+    assert q.remove_value("a", "123").multi_items() == [("b", "456")]
+
+
