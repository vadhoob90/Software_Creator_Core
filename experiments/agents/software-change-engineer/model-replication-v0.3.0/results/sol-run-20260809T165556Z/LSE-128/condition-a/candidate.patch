+
+
+def test_stash_pop() -> None:
+    stash = Stash()
+    str_key = StashKey[str]()
+    int_key = StashKey[int]()
+
+    stash[str_key] = "value"
+    assert assert_type(stash.pop(str_key), str) == "value"
+    assert str_key not in stash
+    assert len(stash) == 0
+
+    with pytest.raises(KeyError):
+        stash.pop(str_key)
+    assert len(stash) == 0
+
+    assert assert_type(stash.pop(str_key, 42), str | int) == 42
+    assert assert_type(stash.pop(str_key, None), str | None) is None
+    assert str_key not in stash
+    assert len(stash) == 0
+
+    stash[int_key] = 10
+    assert stash.get(int_key, None) == 10
+    assert stash.setdefault(int_key, 20) == 10
+    assert int_key in stash
+    del stash[int_key]
+    assert int_key not in stash
+    assert len(stash) == 0
