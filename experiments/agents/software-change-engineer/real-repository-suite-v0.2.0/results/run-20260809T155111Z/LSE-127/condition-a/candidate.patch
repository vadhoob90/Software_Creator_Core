+    def remove_value(self, key: str, value: typing.Any = None) -> QueryParams:
+        """
+        Return a new QueryParams instance, removing the first matching value for a key.
+
+        Usage:
+
+        q = httpx.QueryParams("a=123&a=456")
+        q = q.remove_value("a", "123")
+        assert q == httpx.QueryParams("a=456")
+        """
+        key = str(key)
+        value = primitive_value_to_str(value)
+        q = QueryParams()
+        q._dict = dict(self._dict)
+
+        values = q._dict.get(key)
+        if values is None:
+            return q
+
+        try:
+            index = values.index(value)
+        except ValueError:
+            return q
+
+        values = list(values)
+        values.pop(index)
+        if values:
+            q._dict[key] = values
+        else:
+            del q._dict[key]
+        return q
+
