+def test_queryparam_remove_value():
+    original = httpx.QueryParams("a=123&a=456&a=123&b=789")
+
+    q = original.remove_value("a", "123")
+
+    assert q is not original
+    assert list(q.multi_items()) == [("a", "456"), ("a", "123"), ("b", "789")]
+    assert str(q) == "a=456&a=123&b=789"
+    assert str(original) == "a=123&a=456&a=123&b=789"
+
+
+def test_queryparam_remove_value_coercion_and_noop():
+    original = httpx.QueryParams({"a": [1, True, None], "b": "2"})
+
+    q = original.remove_value("a", True)
+    assert list(q.multi_items()) == [("a", "1"), ("a", ""), ("b", "2")]
+
+    missing_value = original.remove_value("a", 3)
+    missing_key = original.remove_value("missing", 1)
+    assert missing_value is not original
+    assert missing_key is not original
+    assert missing_value == original
+    assert missing_key == original
+    assert str(original) == "a=1&a=true&a=&b=2"
+
+
