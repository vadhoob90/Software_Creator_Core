+        """
+        Return a new QueryParams instance, removing the first matching value of a key.
+
+        Usage:
+
+        q = QueryParams("a=123&a=456")
+        q = q.remove_value("a", "123")
+        assert q == QueryParams("a=456")
+        """
+        q = QueryParams()
+        q._dict = {k: list(v) for k, v in self._dict.items()}
+        key = str(key)
+        value = primitive_value_to_str(value)
+        values = q._dict.get(key)
+        if values is not None and value in values:
+            values.remove(value)
+            if not values:
+                del q._dict[key]
+        return q
