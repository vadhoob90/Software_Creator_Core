+def test_queryparam_remove_value():
+    original = httpx.QueryParams("a=123&a=456&a=123&b=789")
+
+    q = original.remove_value("a", "123")
+
+    assert q.multi_items() == [("a", "456"), ("a", "123"), ("b", "789")]
+    assert original.multi_items() == [
+        ("a", "123"),
+        ("a", "456"),
+        ("a", "123"),
+        ("b", "789"),
+    ]
+
+
+def test_queryparam_remove_value_coerces_key_and_value():
+    q = httpx.QueryParams({1: [True, False, None]})
+
+    assert q.remove_value(1, True) == httpx.QueryParams("1=false&1=")
+    assert q.remove_value("1", None) == httpx.QueryParams("1=true&1=false")
+
+
+@pytest.mark.parametrize("key, value", [("missing", "123"), ("a", "missing")])
+def test_queryparam_remove_value_missing_is_independent_noop(key, value):
+    original = httpx.QueryParams("a=123&b=456")
+
+    q = original.remove_value(key, value)
+
+    assert q == original
+    assert q is not original
+    assert q._dict is not original._dict
+    assert q._dict["a"] is not original._dict["a"]
+
+
