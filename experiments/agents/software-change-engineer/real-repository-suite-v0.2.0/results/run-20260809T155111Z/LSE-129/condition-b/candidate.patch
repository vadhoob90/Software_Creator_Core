+@pytest.mark.parametrize("seconds", (0, 1, 1.5))
+def test_mock_timing_sleep_advances_for_finite_non_negative_durations(
+    mock_timing: _pytest.timing.MockTiming, seconds: float
+) -> None:
+    start = mock_timing.time()
+
+    mock_timing.sleep(seconds)
+
+    assert mock_timing.time() == start + seconds
+
+
+@pytest.mark.parametrize("seconds", (-1, float("nan"), float("inf"), float("-inf")))
+def test_mock_timing_sleep_rejects_invalid_durations_without_changing_time(
+    mock_timing: _pytest.timing.MockTiming, seconds: float
+) -> None:
+    instant = _pytest.timing.Instant()
+    start = mock_timing.time()
+
+    with pytest.raises(ValueError, match="finite, non-negative duration"):
+        mock_timing.sleep(seconds)
+
+    assert mock_timing.time() == start
+    assert instant.elapsed().seconds == 0
+
