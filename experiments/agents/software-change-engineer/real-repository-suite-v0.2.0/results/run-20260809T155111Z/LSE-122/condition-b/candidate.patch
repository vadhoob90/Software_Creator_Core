+
+
+def test_make_default_short_help_ansi_below_max_length():
+    value = f"{click.style('123', fg='red')} 567 90"
+
+    assert click.utils._make_default_short_help(value, 10) == value
+
+
+def test_make_default_short_help_ansi_truncates_at_visible_max_length():
+    first_word = click.style("123", fg="red")
+    value = f"{first_word} 5678 xxxxxx"
+
+    out = click.utils._make_default_short_help(value, 10)
+    assert out == f"{first_word}..."
+    assert len(strip_ansi(out)) <= 10
