diff --git a/tests/test_measure.py b/tests/test_measure.py
index 6155922..7baadea 100644
--- a/tests/test_measure.py
+++ b/tests/test_measure.py
@@ -34,3 +34,28 @@ def test_clamp():
     assert measurement.clamp(None, 50) == Measurement(20, 50)
     assert measurement.clamp(30, None) == Measurement(30, 100)
     assert measurement.clamp(None, None) == Measurement(20, 100)
+
+
+@pytest.mark.parametrize(
+    ("method", "width", "message"),
+    [
+        ("with_minimum", -1, "minimum width"),
+        ("with_maximum", -1, "maximum width"),
+    ],
+)
+def test_measurement_rejects_negative_bound(method, width, message):
+    measurement = Measurement(20, 100)
+
+    with pytest.raises(ValueError, match=message):
+        getattr(measurement, method)(width)
+
+    assert measurement == Measurement(20, 100)
+
+
+def test_clamp_rejects_inverted_bounds_without_changing_measurement():
+    measurement = Measurement(20, 100)
+
+    with pytest.raises(ValueError, match="minimum width.*maximum width"):
+        measurement.clamp(50, 40)
+
+    assert measurement == Measurement(20, 100)
