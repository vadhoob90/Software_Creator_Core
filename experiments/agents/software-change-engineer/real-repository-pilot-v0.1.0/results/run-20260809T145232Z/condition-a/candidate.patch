diff --git a/src/content_creator/pdf_extraction.py b/src/content_creator/pdf_extraction.py
new file mode 100644
index 0000000..c3639b5
--- /dev/null
+++ b/src/content_creator/pdf_extraction.py
@@ -0,0 +1,29 @@
+"""Extract text from PDF documents through an application-owned boundary."""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+from content_creator.ingestion_errors import IngestionError
+
+
+def extract_pdf_page_text(path: Path) -> list[str]:
+    """Extract text from *path* in document page order.
+
+    The third-party reader is intentionally contained here so ingestion can be
+    evaluated against future reader versions at one application-owned seam.
+
+    Args:
+        path (Path): The PDF document to extract.
+
+    Returns:
+        list[str]: Extracted text for each page in document order.
+
+    Raises:
+        IngestionError: If PDF reader support is unavailable.
+    """
+    try:
+        from pypdf import PdfReader
+    except ImportError as exc:
+        raise IngestionError("PDF support requires the pypdf dependency") from exc
+    return [page.extract_text() or "" for page in PdfReader(path).pages]
